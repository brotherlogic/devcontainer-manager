{
	"name": "Devcontainer Manager",
    "image": "mcr.microsoft.com/devcontainers/base:noble",
    "features": {
		"ghcr.io/devcontainers/features/github-cli:1": {},
      "ghcr.io/siri404/devcontainer-ai-features/gemini-cli:1": {},
      "ghcr.io/devcontainers/features/go:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.Go"
			]
		}
	},
	"initializeCommand": "echo \"GH_TOKEN=$(gh auth token)\" > .devcontainer/.env.auth",
	"runArgs": [
		"--network=host",
		"--security-opt",
		"label=disable",
		"--env-file",
		"${localWorkspaceFolder}/.devcontainer/.env.auth"
	],
	"updateRemoteUserUID": true,
	"remoteUser": "vscode",
    "workspaceFolder": "/workspaces/devcontainer-manager",
    	"containerEnv": {
		"DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/user/1000/bus",
		"GH_GIT_PROTOCOL": "ssh",
		"TZ": "America/Los_Angeles"
	},
	"mounts": [
		{
			"source": "${localEnv:HOME}/.ssh",
			"target": "/home/vscode/.ssh",
			"type": "bind",
			"options": [
				"readonly"
			]
		},
	    		"source=/var/run/dbus,target=/var/run/dbus,type=bind",
		"source=/run/user,target=/run/user,type=bind"
	]
}
